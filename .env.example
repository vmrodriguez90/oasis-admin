# Config web de Firebase: Consola de Firebase -> Configuración del proyecto ->
# Tus apps -> App web. No son secretos (viajan al navegador igual), pero viven
# acá para poder apuntar a otro proyecto sin tocar código. Copialo a .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
